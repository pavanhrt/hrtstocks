# Copy to app/.env.local (git-ignored) for local development. Never commit real values.
# Full reference: docs/gcp/environment-variables.md

# --- Database (local PostgreSQL from docker-compose.yml) ---
DATABASE_URL=postgres://hrt:hrt_local_only@127.0.0.1:5432/hrtstocks

# --- Authentication: Firebase Auth emulator (npx firebase-tools emulators:start --only auth) ---
# Public web config (identifiers, not secrets). For the emulator any project id works.
NEXT_PUBLIC_FIREBASE_PROJECT_ID=demo-hrtstocks
NEXT_PUBLIC_FIREBASE_API_KEY=demo-api-key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=localhost
NEXT_PUBLIC_FIREBASE_AUTH_EMULATOR_URL=http://127.0.0.1:9099
FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099
# Invite-only until email verification, abuse controls, authorization tests and cost
# controls are ready. "open" enables public self-signup (also set NEXT_PUBLIC_SIGNUP_MODE=open).
SIGNUP_MODE=invite_only

# --- Chart storage: Cloud Storage emulator ---
CHART_BUCKET=local-charts
STORAGE_EMULATOR_HOST=localhost:4443

# --- Pipeline jobs: spawn the job entrypoints as local processes (development only) ---
JOB_RUNNER=local
