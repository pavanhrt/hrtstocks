{
  "name": "stock-platform-tooling",
  "private": true,
  "type": "module",
  "description": "Local tooling: strategy seeding and rule-engine tests. The deployable app lives in app/; the Edge Function lives in supabase/functions/.",
  "scripts": {
    "test": "node --test supabase/functions/run-screening/rules/*.test.js supabase/functions/run-screening/features/*.test.js supabase/functions/run-screening/charts/*.test.js supabase/functions/run-screening/providers/*.test.js supabase/functions/run-screening/pipeline/*.test.js supabase/functions/run-screening/buy-setup/*.test.js supabase/functions/run-screening/fome/*.test.js supabase/functions/run-screening/*.test.js supabase/functions/fundamentals/*.test.js supabase/functions/fundamentals/providers/*.test.js",
    "seed:strategies": "node supabase/seed/seed-strategies.mjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.45.4",
    "js-yaml": "^4.1.0"
  }
}
