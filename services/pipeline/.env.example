# Copy to services/pipeline/.env.local (git-ignored) and load it when running jobs locally,
# e.g.  node --env-file=.env.local src/jobs/screening.mjs
# Never commit real values. Full reference: docs/gcp/environment-variables.md

# --- Database ---
DATABASE_URL=postgres://hrt:hrt_local_only@127.0.0.1:5432/hrtstocks

# --- Chart storage (Cloud Storage emulator) ---
CHART_BUCKET=local-charts
STORAGE_EMULATOR_HOST=localhost:4443

# --- FYERS market data ---
# The access token expires DAILY and is refreshed manually (docs/gcp/runbooks/fyers-token.md).
# Deployed environments read it from Secret Manager; locally keep it only in this ignored file.
FYERS_APP_ID=
FYERS_ACCESS_TOKEN=

# --- Optional tuning ---
# SCREENING_MAX_RUN_MINUTES=40
# BUY_SETUP_MAX_RUN_MINUTES=40
# DB_POOL_MAX=4
